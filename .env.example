# Copy to .env and adjust. Values are shared by the docker-compose files.

POSTGRES_USER=bench
POSTGRES_PASSWORD=change_me
POSTGRES_DB=store
POSTGRES_PORT=5432

MYSQL_USER=bench
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=store
MYSQL_PORT=3306

MONGO_INITDB_ROOT_USERNAME=bench
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DB=store
MONGO_PORT=27017

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Identical limits for every engine keep the comparison fair.
DB_CPUS=2
DB_MEMORY=4g
